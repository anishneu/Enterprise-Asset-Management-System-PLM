# Single project env file — used by local uvicorn AND docker compose.
# Copy: cp .env.example .env

# ── MySQL / backend DB (one set of credentials) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=authdb
DB_USER=root
DB_PASSWORD=root

# Root password for the MySQL Docker image (usually same as DB_PASSWORD when DB_USER=root)
MYSQL_ROOT_PASSWORD=root

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# Local backend / browser use localhost. Docker Compose overrides KEYCLOAK_URL
# for the backend container to http://keycloak:8080.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=amsrealm
KEYCLOAK_CLIENT_ID=ams-react

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (browser always uses host ports) ─────────────────────────────────
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=amsrealm
REACT_APP_KEYCLOAK_CLIENT_ID=ams-react

# ── Optional email ────────────────────────────────────────────────────────────
# ADMIN_NOTIFY_EMAIL=you@example.com
# SMTP_PASSWORD=your-gmail-app-password
