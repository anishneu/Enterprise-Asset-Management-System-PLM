# Where admin action alerts are sent (add/edit user, password reset, etc.)
ADMIN_NOTIFY_EMAIL=cyberzerox@gmail.com

# REQUIRED: Gmail app password for the account configured in Keycloak realm email settings.
# Keycloak's API hides the SMTP password, so you must set it here.
# Create one at https://myaccount.google.com/apppasswords (use the Keycloak SMTP Gmail account).
# Paste with or without spaces — spaces are stripped automatically.
SMTP_PASSWORD=

# Optional: only set if different from the Keycloak SMTP user
# SMTP_USER=cyberzerox27@gmail.com
# SMTP_FROM=cyberzerox27@gmail.com

# Optional full override (if not using Keycloak SMTP host/port)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true

# Application branding in emails
# APP_NAME=TalonVault
# APP_BASE_URL=http://localhost:3000
